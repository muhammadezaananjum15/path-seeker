{
  "name": "pathseeker-client",
  "private": true,
  "version": "1.0.0",
  "description": "PathSeeker — React/Vite Career Passport Frontend",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0 --port 5173\" \"cd server && npm run dev\"",
    "client": "vite --host 0.0.0.0 --port 5173",
    "server": "cd server && npm run dev",
    "build": "vite build",
    "start": "node server/src/server.js",
    "postinstall": "cd server && npm install",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "lint": "oxlint"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
