# ═══════════════════════════════════════════════════════════════════════════════
#  PathSeeker — Server Environment Example
#  Copy this file to server/.env and fill in your values.
#  NEVER commit server/.env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Option A: MongoDB Atlas (recommended)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pathseeker?retryWrites=true&w=majority
# Option B: Local MongoDB
# MONGO_URI=mongodb://127.0.0.1:27017/pathseeker

# ─── JWT Authentication ─────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Google Gemini AI ──────────────────────────────────────────────────────────
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Anthropic Claude AI ───────────────────────────────────────────────────────
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── YouTube Data API v3 ───────────────────────────────────────────────────────
# Get key: https://console.cloud.google.com/ → YouTube Data API v3
YOUTUBE_API_KEY=

# ─── Google Custom Search API ──────────────────────────────────────────────────
# Get key: https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ─── Tavily Search API ─────────────────────────────────────────────────────────
# Get key: https://tavily.com/
TAVILY_API_KEY=

# ─── SerpAPI ───────────────────────────────────────────────────────────────────
# Get key: https://serpapi.com/
SERPAPI_KEY=

# ─── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
# Use a Gmail App Password (not your real password):
# https://myaccount.google.com/apppasswords
EMAIL_PASS=your_16_char_app_password
